# ==============================================================================
# Configurações do Sistema de RH e Folha de Pagamento - Backend (Flask)
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# NUNCA envie o arquivo .env com credenciais reais para o controle de versão.
# ==============================================================================

# Chave secreta para assinatura dos tokens JWT (HS256)
# Em produção, gere uma chave segura (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-troque-esta-chave-em-producao-0123456789

# Caminho do banco de dados SQLite (padrão relativo a backend/instance/rh.db)
# DATABASE=instance/rh.db

# Tempo de validade do token JWT em horas (RNF-01)
TOKEN_HORAS=8

# Origem autorizada para CORS (Em desenvolvimento '*' ou URL do frontend, ex: http://localhost:5173)
CORS_ORIGIN=*

# Modo de depuração do Flask (True apenas em desenvolvimento local, False em produção)
FLASK_DEBUG=False

# Porta do servidor
PORT=5000
